# Copy to .env for local dev; set the same keys in your host's dashboard for deploys.
# Both are safe to expose in the client bundle (the anon key is public by design;
# Row Level Security is what protects data).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
